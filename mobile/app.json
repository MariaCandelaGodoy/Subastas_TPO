{
  "expo": {
    "jsEngine": "hermes",
    "name": "BidVault",
    "slug": "bidvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bidvault-logo.png",
    "scheme": "bidvault",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/bidvault-logo.png",
      "backgroundColor": "#E7DFC7",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/bidvault-logo.png",
        "backgroundColor": "#E7DFC7"
      }
    },
    "extra": {
      "apiUrl": "https://bidvault-api-913021689473.us-central1.run.app/api"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
